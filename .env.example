# Copy to .env and fill in values. Never commit .env.

# Account: personal (plain auth)
IMAP_MCP_PERSONAL_PASSWORD=

# Account: gmail (App Password — NOT your regular Google password)
# Generate at: https://myaccount.google.com/apppasswords (requires 2SV enabled)
# Name it "imap-mcp", copy the 16-char code without spaces
GMAIL_APP_PASSWORD=

# Account: work Gmail/Google Workspace via OAuth2 (alternative to App Password)
IMAP_MCP_WORK_OAUTH_CLIENT_ID=
IMAP_MCP_WORK_OAUTH_CLIENT_SECRET=

# Server
IMAP_MCP_SERVER_PORT=8765

# Enrichment
IMAP_MCP_OLLAMA_URL=http://localhost:11434
