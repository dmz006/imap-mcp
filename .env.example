# imap-mcp environment example. Copy to .env, fill in values, never commit .env.
# Placeholder values only. Leave a line empty (or delete it) to keep the YAML value.
#
# Two kinds of variables:
#   1. Reference targets: any name used as ${NAME} in config.yaml. These names
#      are your choice; the ones below match config.example.yaml.
#   2. IMAP_MCP_* overrides: fixed names read by internal/config, applied on top
#      of the YAML values after ${NAME} references are expanded.

# ── 1. Reference targets used by config.example.yaml ──────────────────────────

# Account "personal" (plain auth)
IMAP_MCP_PERSONAL_PASSWORD=

# Account "gmail": an App Password, NOT your regular Google password.
# Generate at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
GMAIL_APP_PASSWORD=

# Account "work-gmail" (Google Workspace OAuth, Path A)
GMAIL_OAUTH_CLIENT_ID=

# Account "work" (Microsoft 365 with an App Password)
IMAP_MCP_WORK_PASSWORD=
# Account "work" via Microsoft OAuth2 (alternative to the App Password; IMAP only)
IMAP_MCP_WORK_OAUTH_CLIENT_ID=
IMAP_MCP_WORK_OAUTH_CLIENT_SECRET=

# server.auth bearer tokens for `imap-mcp serve`: at least 32 characters each.
# Generate with: openssl rand -hex 32
IMAP_MCP_TOKEN_CLAUDE=<token>
IMAP_MCP_TOKEN_DATAWATCH=<token>

# datawatch integration (only if the datawatch: block is enabled). Keep the
# datawatch service token in the environment and reference it from config as
# token: ${IMAP_MCP_DATAWATCH_TOKEN}; never write it into the YAML.
DATAWATCH_API_URL=https://127.0.0.1:8443
IMAP_MCP_DATAWATCH_TOKEN=<datawatch-service-token>

# ── 2. IMAP_MCP_* overrides (internal/config applyEnvOverrides) ───────────────

# Server
# IMAP_MCP_SERVER_HOST=127.0.0.1
# IMAP_MCP_SERVER_PORT=8765
# IMAP_MCP_SERVER_AUTH_DISABLED=false     # true = insecure, no bearer auth

# Databases (keys: passphrase, or a ${secret:name} reference)
# IMAP_MCP_DB_PATH=~/.local/share/imap-mcp/imap.db
# IMAP_MCP_DB_CACHE_PATH=~/.local/share/imap-mcp/cache.db
# IMAP_MCP_DB_ENCRYPTION_KEY=<passphrase>
# IMAP_MCP_DB_CACHE_ENCRYPTION_KEY=<passphrase>

# Sync cache
# IMAP_MCP_SYNC_INTERVAL_MINUTES=15
# IMAP_MCP_SYNC_WINDOW_DAYS=30
# IMAP_MCP_SYNC_MAX_MESSAGE_MB=25
# IMAP_MCP_SYNC_KEEP_FLAGGED=false
# IMAP_MCP_SYNC_VACUUM_INTERVAL_HOURS=24

# Enrichment
# IMAP_MCP_OLLAMA_URL=http://localhost:11434
# IMAP_MCP_ENRICHMENT_CONCURRENCY=2
# IMAP_MCP_ENRICHMENT_BACKFILL_PER_MINUTE=30
# IMAP_MCP_ENRICHMENT_MAX_ATTEMPTS=3
# IMAP_MCP_ENRICHMENT_BACKOFF_MAX_SECONDS=300
# IMAP_MCP_ENRICHMENT_BACKFILL_WINDOW=22:00-07:00
# IMAP_MCP_ENRICHMENT_CLASSIFY_PROVIDER=ollama   # or datawatch
# IMAP_MCP_ENRICHMENT_YIELD=true

# Logging
# IMAP_MCP_LOG_LEVEL=info                 # debug | info | warn | error
